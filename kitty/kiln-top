#!/usr/bin/env python3
"""kiln-top — what this machine and these agents are actually doing.

    ~/.config/kitty/kiln-top          2s refresh
    ~/.config/kitty/kiln-top -i 1     faster
    ~/.config/kitty/kiln-top --once   one frame, no alt-screen (for piping)

q or ctrl-c quits.

ON-DEMAND BY DESIGN. kitty.conf's performance section is explicit that this
setup has no idle repaints, and the statusline cat is already paying ~21 ms per
render per open session. A dashboard that ran all the time would be a second
standing cost for something you look at for ten seconds. This costs exactly
nothing until you open it.

EVERY NUMBER HERE IS SAMPLED, NOT ESTIMATED, and the cheap way was measured
rather than assumed:

  CPU        host_statistics(HOST_CPU_LOAD_INFO) via ctypes — the same tick
             counters top itself differences. 0.8 ms a sample. `ps -A -o %cpu`
             was tried first and read 8.2% when the true figure was 15.1%,
             because macOS %cpu is a decaying per-process average. `top -l 1`
             is accurate but costs 390 ms, which is 20% of a 2 s tick.
  memory     vm_stat pages: active + wired + compressed against hw.memsize.
  agents     ~/.claude/projects/*/*/subagents/agent-*.jsonl. mtime is the
             liveness signal; model and token usage come from the last record
             carrying them. Files reach megabytes, so only the tail is read.
  limits     ~/.claude/cache/ratelimits and fablelimit — the same files the
             statusline reads, written from Claude Code's own payload. Never
             recomputed here.

GLYPHS ARE SHAPED, NOT GUESSED. Every character below went through
`check-art` against the live font first. The vertical ramp, the horizontal
ramp and the box drawing are all one glyph per cell. Braille is NOT in
JetBrainsMono at all (it renders as tofu), and neither are the statusline's
own gauge blocks; that is why nothing here uses them.
"""
import ctypes
import ctypes.util
import glob
import json
import os
import subprocess
import sys
import termios
import time
import tty

# ── kiln palette ────────────────────────────────────────────────────────────
R = "\033[0m"
def fg(h):
    return f"\033[38;2;{int(h[0:2],16)};{int(h[2:4],16)};{int(h[4:6],16)}m"

FG, DIM, EMBER = fg("f0e5d1"), fg("9a8f84"), fg("efa84e")
CLAY, TERRA, GREEN, BLUE = fg("7a5432"), fg("d8624e"), fg("a4cb6f"), fg("7da6d9")
B = "\033[1m"

RAMP = " ▁▂▃▄▅▆▇█"        # CLEAN, 9 cells
BAR  = "▏▎▍▌▋▊▉█"          # CLEAN, 8 cells

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".claude", "cache")
SESSIONS = os.path.join(HOME, ".claude", "sessions")
PROJECTS = os.path.join(HOME, ".claude", "projects")

# ── samplers ────────────────────────────────────────────────────────────────
_libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
_CPU_STATES = 4


class _CpuLoad(ctypes.Structure):
    _fields_ = [("cpu_ticks", ctypes.c_uint * _CPU_STATES)]


def cpu_ticks():
    """user, system, idle, nice — aggregate across all cores."""
    count = ctypes.c_uint(_CPU_STATES)
    info = _CpuLoad()
    if _libc.host_statistics(_libc.mach_host_self(), 3,
                             ctypes.byref(info), ctypes.byref(count)) != 0:
        return None
    return list(info.cpu_ticks)


def sysctl(name, numeric=True):
    try:
        out = subprocess.run(["/usr/sbin/sysctl", "-n", name],
                             capture_output=True, text=True, timeout=2).stdout.strip()
        return int(out) if numeric else out
    except Exception:
        return 0 if numeric else ""


def memory():
    """(used_bytes, total_bytes). Used = active + wired + compressed, which is
    what macOS itself counts as unavailable; free + inactive is reclaimable."""
    total = sysctl("hw.memsize")
    try:
        out = subprocess.run(["/usr/bin/vm_stat"], capture_output=True,
                             text=True, timeout=2).stdout
    except Exception:
        return 0, total
    page = 4096
    vals = {}
    for line in out.splitlines():
        if "page size of" in line:
            for tok in line.split():
                if tok.isdigit():
                    page = int(tok)
        if ":" in line:
            k, _, v = line.partition(":")
            v = v.strip().rstrip(".")
            if v.isdigit():
                vals[k.strip()] = int(v)
    used = sum(vals.get(k, 0) for k in
               ("Pages active", "Pages wired down", "Pages occupied by compressor"))
    return used * page, total


def swap_used():
    s = sysctl("vm.swapusage", numeric=False)
    try:
        used = s.split("used =")[1].split()[0]
        return float(used.rstrip("M")) * 1024 * 1024
    except Exception:
        return 0


def battery():
    try:
        out = subprocess.run(["/usr/bin/pmset", "-g", "batt"],
                             capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return None, ""
    pct, state = None, ""
    for tok in out.replace(";", " ").split():
        if tok.endswith("%") and tok[:-1].isdigit():
            pct = int(tok[:-1])
    low = out.lower()
    if "ac attached" in low or "charging" in low:
        state = "charging" if "; charging" in low else "AC"
    else:
        state = "battery"
    return pct, state


def net_bytes():
    """(rx, tx) totals across real interfaces."""
    try:
        out = subprocess.run(["/usr/sbin/netstat", "-ib"], capture_output=True,
                             text=True, timeout=2).stdout
    except Exception:
        return 0, 0
    rx = tx = 0
    seen = set()
    for line in out.splitlines()[1:]:
        f = line.split()
        if len(f) < 11 or f[0] in seen or f[0].startswith("lo"):
            continue
        try:
            rx += int(f[6]); tx += int(f[9]); seen.add(f[0])
        except (ValueError, IndexError):
            continue
    return rx, tx


def disk_free(path="/"):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize
    except Exception:
        return 0, 0


def limits():
    """(five_pct, five_reset, week_pct, week_reset, fable_pct, fable_reset)."""
    five = week = -1
    five_r = week_r = 0
    try:
        with open(os.path.join(CACHE, "ratelimits")) as f:
            p = f.read().split()
        five, five_r, week, week_r = int(p[0]), int(p[1]), int(p[2]), int(p[3])
    except Exception:
        pass
    fab, fab_r = -1, 0
    try:
        with open(os.path.join(CACHE, "fablelimit")) as f:
            p = f.read().split("\t")
        fab, fab_r = int(p[1]), int(p[2])
    except Exception:
        pass
    return five, five_r, week, week_r, fab, fab_r


def ps_map():
    """pid -> (%cpu, rss_bytes) for everything, one fork."""
    out = {}
    try:
        r = subprocess.run(["/bin/ps", "-A", "-o", "pid=,%cpu=,rss="],
                           capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return out
    for line in r.splitlines():
        f = line.split()
        if len(f) == 3:
            try:
                out[int(f[0])] = (float(f[1]), int(f[2]) * 1024)
            except ValueError:
                pass
    return out


def sessions(psm):
    """Live Claude Code sessions, from the files the CLI itself maintains."""
    rows = []
    for path in glob.glob(os.path.join(SESSIONS, "*.json")):
        try:
            with open(path) as f:
                d = json.load(f)
        except Exception:
            continue
        pid = d.get("pid")
        if not isinstance(pid, int) or pid not in psm:
            continue            # the file outlives the process; skip the dead
        started = d.get("startedAt") or 0
        rows.append({
            "name": d.get("name") or "?",
            "cwd": os.path.basename(d.get("cwd") or "") or "/",
            "status": d.get("status") or "?",
            "age": time.time() - started / 1000 if started > 1e12 else 0,
            "cpu": psm[pid][0], "rss": psm[pid][1], "pid": pid,
        })
    rows.sort(key=lambda r: -r["rss"])
    return rows


_agent_cache = {}


def agents(limit=7):
    """Subagents across every project, newest first.

    The transcripts reach megabytes, so the tail is read rather than the file,
    and a parse is cached against (size, mtime) — a finished agent is never
    re-read."""
    rows = []
    for path in glob.glob(os.path.join(PROJECTS, "*", "*", "subagents", "agent-*.jsonl")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        if time.time() - st.st_mtime > 3600:
            continue
        key = (path, st.st_size, int(st.st_mtime))
        hit = _agent_cache.get(key)
        if hit is None:
            hit = _parse_agent(path, st.st_size)
            _agent_cache[key] = hit
        rows.append({**hit, "mtime": st.st_mtime, "size": st.st_size,
                     "id": os.path.basename(path)[6:-6]})
    rows.sort(key=lambda r: -r["mtime"])
    return rows[:limit]


def _parse_agent(path, size):
    """model + last usage + first timestamp, from head and tail only."""
    model, tok_in, tok_out, started = "", 0, 0, None
    try:
        with open(path, "rb") as f:
            first = f.readline().decode("utf-8", "replace")
            if size > 262144:
                f.seek(-262144, os.SEEK_END)
                f.readline()          # discard the partial line
            tail = f.read().decode("utf-8", "replace")
    except Exception:
        return {"model": "", "tin": 0, "tout": 0, "started": None}
    try:
        started = json.loads(first).get("timestamp")
    except Exception:
        pass
    for line in tail.splitlines():
        if '"usage"' not in line and '"model"' not in line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        m = d.get("message")
        if not isinstance(m, dict):
            continue
        if m.get("model"):
            model = m["model"]
        u = m.get("usage")
        if isinstance(u, dict):
            tok_in = (u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0)
                      + u.get("cache_creation_input_tokens", 0))
            tok_out = u.get("output_tokens", 0)
    return {"model": model, "tin": tok_in, "tout": tok_out, "started": started}


# ── formatting ──────────────────────────────────────────────────────────────
def human(n, unit=""):
    for s, d in (("T", 1 << 40), ("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)):
        if n >= d:
            return f"{n/d:.1f}{s}{unit}"
    return f"{int(n)}{unit}"


def kilo(n):
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1000:
        return f"{n/1000:.0f}k"
    return str(int(n))


def dur(sec):
    sec = int(max(0, sec))
    if sec >= 86400:
        return f"{sec//86400}d{(sec % 86400)//3600:02d}h"
    if sec >= 3600:
        return f"{sec//3600}h{(sec % 3600)//60:02d}m"
    if sec >= 60:
        return f"{sec//60}m{sec % 60:02d}s"
    return f"{sec}s"


def spark(hist, width):
    """Vertical ramp over the last `width` samples, scaled 0..100."""
    vals = list(hist)[-width:]
    if not vals:
        return ""
    pad = " " * (width - len(vals))
    out = []
    for v in vals:
        i = int(max(0.0, min(100.0, v)) / 100.0 * (len(RAMP) - 1) + 0.5)
        out.append(RAMP[i])
    return pad + "".join(out)


def gauge(pct, width=10, colour=None):
    """Horizontal fill. Sub-cell precision from the eighths ramp."""
    if pct < 0:
        return DIM + "─" * width + R
    filled = max(0.0, min(100.0, pct)) / 100.0 * width
    whole = int(filled)
    rest = filled - whole
    s = "█" * whole
    if whole < width and rest > 1 / 16:
        s += BAR[min(len(BAR) - 1, int(rest * 8))]
    s = s.ljust(width, " ")
    c = colour or (GREEN if pct < 50 else EMBER if pct < 80 else TERRA)
    return c + s + R


def heat(pct):
    return GREEN if pct < 50 else EMBER if pct < 80 else TERRA


def rule(title, width):
    """Section header the same shape kitty-keys uses: name, then a rule.

    An earlier version drew boxes with ╭╮╰╯ and no side walls, so every panel
    read as unclosed. Closing them properly would mean measuring the visible
    width of lines that are mostly SGR escapes; matching the cheatsheet is both
    simpler and more consistent with the rest of this setup."""
    return (f"{EMBER}{B}{title}{R}  {CLAY}"
            + "─" * max(0, width - len(title) - 4) + R)


def endrule(width):
    return ""


# ── frame ───────────────────────────────────────────────────────────────────
def frame(state, width):
    W = max(64, min(width, 110))
    L = []
    inner = W - 4

    # MACHINE
    L.append(rule("MACHINE", W))
    c = state["cpu"]
    L.append(f"  {DIM}cpu {R}{heat(c)}{c:5.1f}%{R} {spark(state['cpu_h'], 34)}"
             f"  {DIM}load{R} {state['load']}")
    used, total = state["mem"]
    mp = 100.0 * used / total if total else 0
    L.append(f"  {DIM}mem {R}{heat(mp)}{mp:5.1f}%{R} {gauge(mp, 12)} "
             f"{DIM}{human(used)}/{human(total)}{R}"
             + (f"  {DIM}swap {human(state['swap'])}{R}" if state["swap"] else ""))
    bp, bs = state["batt"]
    free, dtot = state["disk"]
    bits = []
    if bp is not None:
        bits.append(f"{DIM}batt{R} {heat(100-bp)}{bp}%{R} {DIM}{bs}{R}")
    bits.append(f"{DIM}disk{R} {human(free)} {DIM}free{R}")
    bits.append(f"{DIM}net{R} {BLUE}↓{R}{human(state['rx'],'/s')} {BLUE}↑{R}{human(state['tx'],'/s')}")
    L.append("  " + f"  {DIM}·{R}  ".join(bits))
    L.append(endrule(W))

    # CLAUDE
    L.append(rule("CLAUDE", W))
    f5, f5r, wk, wkr, fb, fbr = state["limits"]
    now = time.time()
    def until(ts):
        return f" {DIM}·{R} {DIM}{dur(ts-now)}{R}" if ts > now else ""
    L.append(f"  {DIM}5h {R}{gauge(f5, 10)} {heat(f5)}{f5:3d}%{R}{until(f5r)}"
             f"   {DIM}wk {R}{gauge(wk, 10)} {heat(wk)}{wk:3d}%{R}{until(wkr)}")
    if fb >= 0:
        L.append(f"  {DIM}fable{R} {gauge(fb, 10)} {heat(fb)}{fb:3d}%{R}{until(fbr)}")
    for s in state["sessions"][:5]:
        dot = GREEN + "●" + R if s["status"] == "busy" else DIM + "○" + R
        L.append(f"  {dot} {FG}{s['name'][:16]:16}{R} {DIM}{s['cwd'][:18]:18}{R}"
                 f" {DIM}{dur(s['age']):>7}{R} {DIM}cpu{R} {s['cpu']:4.1f} "
                 f"{DIM}{human(s['rss']):>6}{R}")
    if not state["sessions"]:
        L.append(f"  {DIM}no live sessions{R}")
    L.append(endrule(W))

    # AGENTS
    L.append(rule("AGENTS", W))
    if not state["agents"]:
        L.append(f"  {DIM}no agent activity in the last hour{R}")
    for a in state["agents"]:
        live = now - a["mtime"] < 45
        dot = (GREEN + "●" + R) if live else (DIM + "○" + R)
        model = (a["model"] or "?").replace("claude-", "").replace("-20250929", "")
        el = ""
        if a["started"]:
            try:
                t0 = time.mktime(time.strptime(a["started"][:19], "%Y-%m-%dT%H:%M:%S"))
                t0 -= time.timezone if not time.daylight else time.altzone
                el = dur(a["mtime"] - t0)
            except Exception:
                el = ""
        age = dur(now - a["mtime"])
        L.append(f"  {dot} {FG}{a['id'][:12]:12}{R} {EMBER}{model[:10]:10}{R}"
                 f" {DIM}{el:>7}{R} {DIM}ctx{R} {kilo(a['tin']):>6}"
                 f" {DIM}out{R} {kilo(a['tout']):>5}"
                 f" {DIM}{human(a['size']):>6} {'live' if live else age:>6}{R}")
    L.append(endrule(W))
    L.append(f"  {DIM}q quits · sampled every {state['interval']}s · "
             f"cpu via host_statistics, {state['cost']:.0f} ms/frame{R}")
    return "\n".join(x for x in L if x != "")


def collect(state):
    t0 = time.time()
    ticks = cpu_ticks()
    if ticks and state.get("_ticks"):
        d = [b - a for a, b in zip(state["_ticks"], ticks)]
        tot = sum(d)
        state["cpu"] = 100.0 * (tot - d[2]) / tot if tot else 0.0
    state["_ticks"] = ticks
    state["cpu_h"].append(state["cpu"])
    if len(state["cpu_h"]) > 120:
        del state["cpu_h"][:-120]

    state["mem"] = memory()
    # Slow movers: battery, swap and free space do not change meaningfully on a
    # 2 s timescale, and each is a fork. Sampling them every tenth frame took
    # the frame cost from ~62 ms to ~25 ms with no visible difference.
    state["_slow"] = state.get("_slow", 0) + 1
    if state["_slow"] % 10 == 1:
        state["swap"] = swap_used()
        state["batt"] = battery()
        state["disk"] = disk_free()
    la = os.getloadavg()
    state["load"] = " ".join(f"{x:.2f}" for x in la)

    rx, tx = net_bytes()
    dt = max(0.001, time.time() - state.get("_nt", time.time() - 1))
    if state.get("_rx"):
        state["rx"] = max(0, (rx - state["_rx"]) / dt)
        state["tx"] = max(0, (tx - state["_tx"]) / dt)
    state["_rx"], state["_tx"], state["_nt"] = rx, tx, time.time()

    state["limits"] = limits()
    psm = ps_map()
    state["sessions"] = sessions(psm)
    state["agents"] = agents()
    state["cost"] = (time.time() - t0) * 1000
    return state


def term_width(default=100):
    """os.get_terminal_size() raises OSError when stdout is not a tty — which
    is exactly what happens under `kiln-top > file` or in a pipeline. It was
    called unguarded in the redraw loop and crashed the whole tool on frame 1."""
    try:
        return os.get_terminal_size().columns
    except OSError:
        try:
            return int(os.environ.get("COLUMNS", default))
        except ValueError:
            return default


def main():
    argv = sys.argv[1:]
    once = "--once" in argv
    interval = 2.0
    if "-i" in argv:
        try:
            interval = max(0.5, float(argv[argv.index("-i") + 1]))
        except (ValueError, IndexError):
            pass

    state = {"cpu": 0.0, "cpu_h": [], "rx": 0, "tx": 0, "interval": interval,
             "cost": 0.0, "load": "", "sessions": [], "agents": [],
             "limits": (-1, 0, -1, 0, -1, 0), "mem": (0, 1), "swap": 0,
             "batt": (None, ""), "disk": (0, 0)}
    width = term_width()

    if once:
        collect(state)
        time.sleep(0.25)
        print(frame(collect(state), width))
        return

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd) if sys.stdin.isatty() else None
    try:
        if old:
            tty.setcbreak(fd)
        sys.stdout.write("\033[?1049h\033[?25l")     # alt screen, hide cursor
        collect(state)
        while True:
            width = term_width()
            sys.stdout.write("\033[H\033[2J" + frame(collect(state), width) + "\n")
            sys.stdout.flush()
            if old:
                import select
                r, _, _ = select.select([fd], [], [], interval)
                if r and sys.stdin.read(1) in ("q", "Q", "\x03"):
                    break
            else:
                time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")     # cursor back, main screen
        sys.stdout.flush()
        if old:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    main()
