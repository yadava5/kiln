#!/usr/bin/env python3
"""kiln-top — what this machine and these agents are actually doing.

    ~/.config/kitty/kiln-top          100 ms, full screen
    ~/.config/kitty/kiln-top -i 0.5   slower
    ~/.config/kitty/kiln-top --once   one frame, no alt-screen (pipeable)

q or ctrl-c quits. Opened from kitty with cmd+shift+a, which gives it its OWN
TAB, never an overlay — an overlay covers the pane it opens over, and this
exists to be watched while Claude works. See kiln-top-open.

WHY THIS EXISTS RATHER THAN btop. btop is excellent and is themed for this
palette in ~/.config/btop/themes/kiln.theme; use it for deep process work. It
cannot show the half of this machine that matters here: Claude Code sessions,
running subagents, plan limits, and tokens per minute. Nor GPU on macOS. This
puts the machine and the agents on ONE screen, which is the only place the
question "is that spike me or the agent" can be answered.

HOW 100 ms IS AFFORDABLE — measured, not assumed. Costs live in kiln-sample.py.
CPU, per-core, and memory come from Mach calls through ctypes at 0.0 ms, so
they run EVERY frame. Everything needing a fork is far dearer (ps 28 ms,
ioreg 18 ms, netstat 12 ms) and runs on its own phase; the phases are co-prime
so they seldom collide. Token history is incremental — a full transcript scan
was 188 ms, so each file's byte offset is remembered and only appended bytes
are read, which is 8 ms. The true per-frame peak is printed in the header, so
if this ever stops being cheap the screen says so rather than this docstring.

GLYPHS ARE SHAPED, NOT GUESSED: every character passed check-art against the
live font. Braille is NOT in JetBrainsMono (it renders through a fallback face,
which is why btop's braille graphs look like scattered dots here) and neither
are the statusline's own gauge blocks. Nothing here uses either.
"""
import glob
import importlib.util
import json
import os
import re
import sys
import termios
import time
import tty

_HERE = os.path.dirname(os.path.abspath(__file__))
_sp = importlib.util.spec_from_file_location(
    "kiln_sample", os.path.join(_HERE, "kiln-sample.py"))
S = importlib.util.module_from_spec(_sp)
_sp.loader.exec_module(S)

R, B = "\033[0m", "\033[1m"
def fg(h): return f"\033[38;2;{int(h[0:2],16)};{int(h[2:4],16)};{int(h[4:6],16)}m"
FG, DIM, EMBER = fg("f0e5d1"), fg("9a8f84"), fg("efa84e")
CLAY, TERRA, GREEN = fg("7a5432"), fg("d8624e"), fg("a4cb6f")
BLUE, CYAN, VIOLET = fg("7da6d9"), fg("68bdab"), fg("c782ba")

RAMP, BARS = " ▁▂▃▄▅▆▇█", "▏▎▍▌▋▊▉█"
SGR = re.compile(r"\033\[[0-9;]*m")
HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".claude", "cache")

vlen = lambda s: len(SGR.sub("", s))
def pad(s, w): return s + " " * max(0, w - vlen(s))

def human(n, u=""):
    for s, d in (("T", 1 << 40), ("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)):
        if n >= d: return f"{n/d:.1f}{s}{u}"
    return f"{int(n)}{u}"

def kilo(n):
    if n >= 1_000_000: return f"{n/1_000_000:.1f}M"
    if n >= 1000: return f"{n/1000:.1f}k"
    return str(int(n))

def dur(x):
    x = int(max(0, x))
    if x >= 86400: return f"{x//86400}d{(x%86400)//3600:02d}h"
    if x >= 3600:  return f"{x//3600}h{(x%3600)//60:02d}m"
    if x >= 60:    return f"{x//60}m{x%60:02d}s"
    return f"{x}s"

def heat(p): return GREEN if p < 50 else EMBER if p < 80 else TERRA

def spark(h, w, scale=None):
    """Missing samples are blank; a measured zero is a floor mark.

    RAMP[0] is a space, so drawing a real 0 with it made an idle series
    invisible — the 10-core row rendered as nothing at all. Values clamp to
    index 1 (▁) so "measured, and it was zero" reads differently from
    "no sample yet".
    """
    v = list(h)[-w:]
    top = scale or (max(v) if v else 1) or 1
    return " " * (w - len(v)) + "".join(
        RAMP[max(1, int(max(0.0, min(1.0, x / top)) * 8 + 0.5))] for x in v)

def gauge(p, w, c=None):
    """A bar that always has a visible extent when the figure is KNOWN.

    The old version padded the unfilled part with spaces, so 0% and 1% drew as
    blank — indistinguishable from a broken gauge, and read exactly that way
    the first morning a five-hour window reset while the panel was open. Now an
    unknown figure is a dim rule and a known one is a dotted track that the
    fill eats into, so "measured zero" and "no reading" can never look alike.
    This is the same rule spark() follows by flooring at RAMP[1].
    """
    if p < 0:
        return DIM + "─" * w + R
    f = max(0.0, min(100.0, p)) / 100.0 * w
    n = int(f)
    s = "█" * n
    if n < w and f - n > .06:
        s += BARS[min(7, int((f - n) * 8))]
    elif not s and p > 0:
        s = BARS[0]                       # a real reading, too small to fill a cell
    return (c or heat(p)) + s + R + DIM + "·" * max(0, w - vlen(s)) + R

def rule(t, w, c=EMBER):
    return f"{c}{B}{t}{R}  {CLAY}" + "─" * max(0, w - len(t) - 4) + R

def limits():
    """Merge every session's rate-limit record into one honest pair.

    The statusline writes one record per session into cache/ratelimits.d,
    `pct reset pct reset observed`. It used to be a single shared file and the
    last writer won, so this panel flickered between sessions several times a
    second — measured 2026-08-22 alternating between a live 17% / 86% and a
    reading whose five-hour window had closed 23 hours earlier, 18% / 61%.

    Per field: discard a window that has already reset, then take the newest
    reset epoch, then the higher percentage within it. The percentage alone is
    not the discriminator — the stale record above read HIGHER than the live
    one on the five-hour figure.
    """
    now = time.time()
    best = [(-1, 0), (-1, 0)]                 # (pct, reset) for 5h and week
    d = os.path.join(CACHE, "ratelimits.d")
    try: names = os.listdir(d)
    except OSError: names = []
    for n in names:
        try:
            with open(os.path.join(d, n)) as f:
                p = f.readline().split()
            vals = [int(x) for x in p[:4]]
        except Exception:
            continue
        for i in (0, 1):
            pct, reset = vals[i * 2], vals[i * 2 + 1]
            if pct < 0 or reset <= now:
                continue
            bp, br_ = best[i]
            if reset > br_ or (reset == br_ and pct > bp):
                best[i] = (pct, reset)
    (five, fr), (week, wr) = best
    fab, br = -1, 0
    try:
        p = open(os.path.join(CACHE, "fablelimit")).read().split("\t")
        fab, br = int(p[1]), int(p[2])
    except Exception: pass
    return five, fr, week, wr, fab, br

def prune_ratelimits(max_age=86400):
    """Drop records from sessions that are gone.

    A live session rewrites its record about once a second, so the observed-at
    stamp in field 5 ages only for a session that has exited. Expiry of the
    window itself is NOT the test — a weekly reset epoch stays valid for days
    after the session that wrote it has died.
    """
    d = os.path.join(CACHE, "ratelimits.d")
    now = time.time()
    try: names = os.listdir(d)
    except OSError: return
    for n in names:
        f = os.path.join(d, n)
        try:
            with open(f) as fh:
                seen = int(fh.readline().split()[4])
        except Exception:
            continue
        if now - seen > max_age:
            try: os.remove(f)
            except OSError: pass


def sessions(pmap):
    rows = []
    for path in glob.glob(os.path.join(HOME, ".claude", "sessions", "*.json")):
        try: d = json.load(open(path))
        except Exception: continue
        pid = d.get("pid")
        if not isinstance(pid, int) or pid not in pmap: continue
        st = d.get("startedAt") or 0
        rows.append({"name": d.get("name") or "?",
                     "sid": d.get("sessionId") or "",
                     "proj": proj(d.get("cwd") or ""),
                     "status": d.get("status") or "?",
                     "age": time.time() - st / 1000 if st > 1e12 else 0,
                     "cpu": pmap[pid][0], "rss": pmap[pid][1]})
    rows.sort(key=lambda r: -r["rss"]); return rows

_EPC = {}
def _ep(iso):
    """ISO-8601 with a Z suffix to a local epoch. The transcripts are UTC.

    MEMOISED. strptime is the whole cost of the agent aggregates: over 1,454
    records it ran to 37 ms a frame, which at 10 Hz is a third of the budget
    for a value that cannot change once a transcript line is written.
    """
    if not iso:
        return 0.0
    v = _EPC.get(iso)
    if v is None:
        try:
            v = time.mktime(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))
            v -= time.altzone if time.daylight else time.timezone
        except (ValueError, TypeError):
            v = 0.0
        _EPC[iso] = v
    return v


def proj(cwd, branch=""):
    """A name a person recognises, from the checkout an agent actually ran in.

    The raw cwd is useless in a column: they all share the same home prefix
    and the interesting part is the tail. A
    worktree is called out explicitly — `wt fold-413` is not the same checkout
    as the repo it was cut from, and an agent working in one cannot see
    uncommitted work in the other.
    """
    if not cwd:
        return "?"
    parts = [x for x in cwd.split("/") if x]
    # TWO worktree conventions live on this disk and they name different
    # things. `<repo>/.claude/worktrees/agent-<id>` is the one the Agent tool
    # cuts per run, so the id is noise and the REPO is the answer.
    # `Projects/.worktrees/<name>` is hand-made and the name is the answer.
    if "worktrees" in parts and ".claude" in parts:
        i = parts.index(".claude")
        return (parts[i - 1] if i else "?") + " wt"
    if ".worktrees" in parts:
        i = parts.index(".worktrees")
        return (parts[i + 1] if len(parts) > i + 1 else parts[i - 1]) + " wt"
    name = parts[-1] if parts else "?"
    if branch and branch not in ("main", "master", "HEAD", ""):
        return f"{name}:{branch}"
    return name


def agent_runs(recs, limit, window_s=86400):
    """Individual runs, most recently active first."""
    rows = []
    now = time.time()
    for r in recs.values():
        if r.get("kind") != "agent":
            continue
        t1 = _ep(r.get("t1"))
        if not t1 or now - t1 > window_s:
            continue
        t0 = _ep(r.get("t0"))
        rows.append({"type": r.get("type") or "?", "slug": r.get("slug") or "",
                     "model": (r.get("model") or "").replace("claude-", ""),
                     "proj": proj(r.get("cwd", ""), r.get("branch", "")),
                     "t0": t0, "t1": t1, "ran": max(0.0, t1 - t0),
                     "out": r.get("out", 0), "ctx": r.get("ctx", 0),
                     "turns": r.get("turns", 0)})
    rows.sort(key=lambda r: -r["t1"])
    return rows[:limit]


def session_stats(recs):
    """sid -> what that session has spent, itself and through its agents.

    The session transcript and its subagents' transcripts are separate files,
    so a session's own output tokens do NOT include its agents'. Both are
    reported; adding them is the total that session put on the plan.
    """
    out = {}
    now = time.time()
    for r in recs.values():
        sid = r.get("sid") or ""
        if not sid:
            continue
        s = out.setdefault(sid, {"own": 0, "aout": 0, "agents": 0, "live": 0})
        if r.get("kind") == "session":
            s["own"] += r.get("out", 0)
        else:
            s["aout"] += r.get("out", 0)
            s["agents"] += 1
            if now - _ep(r.get("t1")) < 45:
                s["live"] += 1
    return out


def agent_totals(recs, limit):
    """Per agent TYPE, all time: how many runs, how long, how much, how recent.

    Runtime is wall clock between an agent's first and last transcript line.
    Agents run concurrently, so these hours overlap each other and the day —
    this is time under an agent, not billed time, and it is not additive with
    the machine's own clock.
    """
    by = {}
    for r in recs.values():
        if r.get("kind") != "agent":
            continue
        k = r.get("type") or "?"
        a = by.setdefault(k, {"n": 0, "ran": 0.0, "out": 0, "last": 0.0, "turns": 0})
        t0, t1 = _ep(r.get("t0")), _ep(r.get("t1"))
        a["n"] += 1
        a["ran"] += max(0.0, t1 - t0)
        a["out"] += r.get("out", 0)
        a["turns"] += r.get("turns", 0)
        a["last"] = max(a["last"], t1)
    rows = [dict(name=k, **v) for k, v in by.items()]
    rows.sort(key=lambda r: -r["ran"])
    return rows[:limit]


def collect(st):
    t0 = time.perf_counter(); n = st["n"] = st.get("n", 0) + 1
    t = S.cpu_ticks()
    if t and st.get("_t"):
        d = [b - a for a, b in zip(st["_t"], t)]; tot = sum(d)
        if tot:
            st["cpu"] = 100.0 * (tot - d[2]) / tot
            st["u"] = 100.0 * (d[0] + d[3]) / tot; st["s"] = 100.0 * d[1] / tot
    st["_t"] = t
    st["cpu_h"].append(st["cpu"]); del st["cpu_h"][:-300]
    # PER-CORE NEEDS A LONGER BASELINE THAN ONE FRAME. The tick counters run at
    # 100 Hz, so in 100 ms a single core accrues 0 or 1 ticks and every core
    # rounds to 0% — the row rendered a flat line of zeros while the aggregate
    # correctly showed 12%, because the aggregate sums ten cores and has ten
    # times the resolution. Each frame is therefore differenced against a
    # reference roughly a second old, which is kept rolling.
    c = S.per_core_ticks()
    now_t = time.perf_counter()
    st.setdefault("_ch", []).append((now_t, c))
    st["_ch"] = [(t, v) for t, v in st["_ch"] if now_t - t <= 2.0][-40:]
    ref = next((v for t, v in st["_ch"] if now_t - t >= 0.8), None)
    if c and ref and len(c) == len(ref):
        out = []
        for a, b in zip(ref, c):
            d = [y - x for x, y in zip(a, b)]; tt = sum(d)
            out.append(100.0 * (tt - d[2]) / tt if tt else 0.0)
        st["cores"] = out
    st["mem"] = S.memory()
    st["mem_h"].append(100.0 * st["mem"][0] / st["mem"][1] if st["mem"][1] else 0)
    del st["mem_h"][:-300]
    # ONE FORK PER FRAME, EVER. Phased modulo scheduling looked fine on paper
    # and then produced 81 ms frames: with periods 3/7/13 there are frames
    # where gpu (19 ms) + processes (26 ms) + net (12 ms) all come due at once.
    # Instead every heavy sampler declares how stale it may get, and each frame
    # runs AT MOST the single most-overdue one. Worst-case frame cost is now
    # the dearest single sampler rather than the sum of all of them, and
    # nothing goes stale by more than its own budget plus a frame or two.
    now_w = time.time()
    due = None
    for name, budget in (("procs", 1.0), ("gpu", 0.4), ("net", 2.0),
                         ("tok", 3.0), ("slow", 20.0)):
        age = now_w - st["last"].get(name, 0)
        if age >= budget and (due is None or age / budget > due[1]):
            due = (name, age / budget)
    if due:
        name = due[0]
        st["last"][name] = now_w
        if name == "procs":
            st["procs"] = S.processes()
            st["pmap"] = {p[0]: (p[1], p[2]) for p in st["procs"]}
            st["sessions"] = sessions(st["pmap"])
        elif name == "gpu":
            g = S.gpu()
            if g:
                st["gpu"] = g
                st["gpu_h"].append(g[0]); del st["gpu_h"][:-300]
        elif name == "net":
            rx, tx = S.net_bytes()
            dt = max(.001, now_w - st.get("_nt", now_w - 1))
            if st.get("_rx"):
                st["rx"] = max(0, (rx - st["_rx"]) / dt)
                st["tx"] = max(0, (tx - st["_tx"]) / dt)
            st["_rx"], st["_tx"], st["_nt"] = rx, tx, now_w
            st["limits"] = limits()
        elif name == "tok":
            st["tok"] = S.token_minutes()
            st["arecs"], st["astatus"] = S.agent_index()
            # Aggregating 1,454 records is 37 ms; doing it per frame cost a
            # third of the 100 ms budget for numbers that move once a minute.
            recs = st["arecs"]
            st["aruns"] = agent_runs(recs, 40)
            st["attl"] = agent_totals(recs, 14)
            st["astat"] = session_stats(recs)
            st["nagent"] = sum(1 for r in recs.values() if r.get("kind") == "agent")
        elif name == "slow":
            st["batt"] = S.battery(); st["swap"] = S.swap_used()
            st["disk"] = S.disk_free(); prune_ratelimits()
    st["load"] = " ".join(f"{x:.2f}" for x in os.getloadavg())
    st["ch"].append((time.perf_counter() - t0) * 1000); del st["ch"][:-60]
    # The first frames fire every phase at once; reporting their cost forever
    # would describe a burst that never recurs. Peak over the recent window,
    # after the warm-up frames.
    recent = st["ch"][-40:] if len(st["ch"]) > 6 else st["ch"]
    st["cost"] = max(recent) if recent else 0.0
    st["avg"] = sum(recent) / len(recent) if recent else 0.0
    return st

def frame(st, W, H):
    L = []
    used, total, wired, active, comp, cached = st["mem"]
    mp = 100.0 * used / total if total else 0
    cpu = st["cpu"]; g = st.get("gpu")
    # Peak alone overstates it: most frames run no fork at all and cost ~0 ms,
    # while the one frame a second that re-reads the process table costs ~44.
    # Both numbers, so neither flatters nor alarms.
    hdr = (f"{DIM}q quits · {int(st['interval']*1000)} ms · "
           f"{st.get('avg',0):.1f} ms avg, {st['cost']:.0f} peak"
           f" · {time.strftime('%H:%M:%S')}{R}")
    L.append(pad(f" {EMBER}{B}kiln{R} {DIM}·{R} {FG}activity{R}", W - vlen(hdr) - 1) + hdr)
    L.append("")
    sw = max(18, min(52, W - 66))
    L.append(f" {DIM}CPU{R} {heat(cpu)}{B}{cpu:5.1f}%{R} {heat(cpu)}{spark(st['cpu_h'],sw,100)}{R}"
             f"  {DIM}user{R} {st['u']:4.1f} {DIM}sys{R} {st['s']:4.1f}  {DIM}load{R} {st['load']}")
    if st.get("cores"):
        cs = " ".join(heat(c) + RAMP[max(1, int(min(100, c) / 100 * 8 + .5))] + R
                      for c in st["cores"])
        L.append(f" {DIM}{len(st['cores']):>3} cores{R} {cs}   "
                 f"{DIM}busiest{R} {max(st['cores']):.0f}%  {DIM}idlest{R} {min(st['cores']):.0f}%")
    if g:
        gu, gr, gt, vin, val = g
        L.append(f" {DIM}GPU{R} {heat(gu)}{B}{gu:5.1f}%{R} {heat(gu)}{spark(st['gpu_h'],sw,100)}{R}"
                 f"  {DIM}render{R} {gr:>3}% {DIM}tiler{R} {gt:>3}%  {DIM}vram{R} {human(vin)}{DIM}/{human(val)}{R}")
    L.append(f" {DIM}MEM{R} {heat(mp)}{B}{mp:5.1f}%{R} {heat(mp)}{spark(st['mem_h'],sw,100)}{R}"
             f"  {DIM}{human(used)}/{human(total)}   wired{R} {human(wired)} {DIM}active{R} {human(active)}"
             f" {DIM}comp{R} {human(comp)} {DIM}cached{R} {human(cached)}")
    bp, bs = st["batt"]; free, _ = st["disk"]
    L.append(f"     {DIM}swap{R} {human(st['swap'])}"
             + (f"  {DIM}·  batt{R} {heat(100-(bp or 0))}{bp}%{R} {DIM}{bs}{R}" if bp else "")
             + f"  {DIM}·  disk{R} {human(free)} {DIM}free  ·  net{R} "
               f"{BLUE}↓{R}{human(st['rx'],'/s')} {BLUE}↑{R}{human(st['tx'],'/s')}")
    L.append("")
    lw = max(36, int(W * 0.44)); rw = W - lw - 3
    left, right = [], []
    procs = st.get("procs") or []
    # Fill the window. The header block is ~7 rows and each panel costs a rule
    # plus a blank; whatever is left is split between the process table and the
    # session/agent lists rather than left as dead space.
    body = max(6, H - len(L) - 2)
    nproc = max(5, min(34, body - 2))
    # The right column is four panels now, each costing a rule and a trailing
    # blank. Sessions and totals are bounded by how many actually exist, and
    # the runs list takes whatever is left, so the column fills the window
    # instead of ending a dozen rows above the process table.
    nsess = max(2, min(8, len(st.get("sessions") or []) or 2))
    ntot = max(3, min(9, body - nsess - 14))
    nrun = max(2, body - 10 - ntot - nsess)
    left.append(rule("WHERE IT GOES", lw))
    half = lw // 2
    left.append(pad(f" {DIM}by cpu{R}", half) + f"{DIM}by memory{R}")
    bc = sorted(procs, key=lambda p: -p[1])[:nproc]
    bm = sorted(procs, key=lambda p: -p[2])[:nproc]
    for i in range(nproc):
        a = (f" {heat(min(100,bc[i][1]))}{bc[i][1]:5.1f}{R} {FG}{bc[i][3][:13]:13}{R}"
             if i < len(bc) else "")
        b = (f"{CYAN}{human(bm[i][2]):>6}{R} {FG}{bm[i][3][:13]:13}{R}"
             if i < len(bm) else "")
        left.append(pad(a, half) + b)
    right.append(rule("TOKENS", rw))
    tok = st.get("tok") or {}
    now_m = int(time.time() // 60)
    # Width must allow for everything printed AFTER the sparkline — " out/min ",
    # the rate, the peak and the total. Sizing it at rw-34 overflowed the
    # column and the wrapped remainder surfaced inside the left panel.
    span = max(20, min(90, rw - 54))
    series = [tok.get(now_m - i, 0) for i in range(span - 1, -1, -1)]
    peak = max(series) if series else 0
    tw = span
    right.append(f" {DIM}out/min{R} {VIOLET}{spark(series, tw)}{R}"
                 f"  {FG}{kilo(series[-1] if series else 0)}{R}{DIM}/min"
                 f"  peak {kilo(peak)}  {span}m {kilo(sum(series))}{R}")
    f5, f5r, wk, wkr, fb, fbr = st["limits"]; now = time.time()
    u = lambda ts: f" {DIM}{dur(ts-now)}{R}" if ts > now else ""
    right.append(f" {DIM}5h{R} {gauge(f5,10)} {heat(f5)}{f5:3d}%{R}{u(f5r)}"
                 f"   {DIM}wk{R} {gauge(wk,10)} {heat(wk)}{wk:3d}%{R}{u(wkr)}")
    if fb >= 0:
        right.append(f" {DIM}fable{R} {gauge(fb,10)} {heat(fb)}{fb:3d}%{R}{u(fbr)}")
    right.append("")
    recs = st.get("arecs") or {}
    status = st.get("astatus") or ("indexing", 0, 0)
    runs = (st.get("aruns") or [])[:nrun]
    ttl = (st.get("attl") or [])[:ntot]
    nagentrec = st.get("nagent", 0)
    live_n = sum(1 for a in runs if now - a["t1"] < 45)
    head = "AGENT RUNS" + (f" · {live_n} live" if live_n else " · last 24 h")
    right.append(rule(head, rw))
    if status[0] == "indexing" and not recs:
        # A zero here would be indistinguishable from "no agent ever ran".
        right.append(f" {DIM}indexing transcripts… {status[1]}/{status[2]}{R}")
    elif not runs:
        right.append(f" {DIM}no agent runs in the last 24 hours{R}")
    for a in runs:
        live = now - a["t1"] < 45
        dot = (GREEN + "●" + R) if live else (DIM + "○" + R)
        right.append(f" {dot} {EMBER}{a['type'][:11]:11}{R} {FG}{a['proj'][:16]:16}{R}"
                     f" {DIM}{a['model'][:8]:8}{R} {DIM}ran{R} {dur(a['ran']):>6}"
                     f" {DIM}ctx{R} {kilo(a['ctx']):>6} {DIM}out{R} {kilo(a['out']):>6}"
                     f" {DIM}{'live' if live else dur(now - a['t1']) + ' ago':>8}{R}")
    right.append("")
    right.append(rule(f"AGENT TOTALS · {nagentrec} runs all time", rw, CLAY))
    if status[0] == "indexing" and not recs:
        right.append(f" {DIM}indexing…{R}")
    for a in ttl:
        right.append(f" {EMBER}{a['name'][:15]:15}{R} {DIM}runs{R} {a['n']:>4}"
                     f" {DIM}ran{R} {dur(a['ran']):>7} {DIM}out{R} {kilo(a['out']):>6}"
                     f" {DIM}turns{R} {a['turns']:>5}"
                     f" {DIM}last {dur(now - a['last']) + ' ago' if a['last'] else '?':>9}{R}")
    right.append("")
    right.append(rule("CLAUDE SESSIONS", rw, CLAY))
    sstat = st.get("astat") or {}
    for ss in st["sessions"][:nsess]:
        dot = GREEN + "●" + R if ss["status"] == "busy" else DIM + "○" + R
        s = sstat.get(ss["sid"], {"own": 0, "aout": 0, "agents": 0, "live": 0})
        ag = (f"{GREEN}{s['live']} live{R}/{s['agents']}" if s["live"]
              else f"{DIM}{s['agents']:>7}{R}")
        right.append(f" {dot} {FG}{ss['name'][:18]:18}{R} {EMBER}{ss['proj'][:14]:14}{R}"
                     f" {DIM}up{R} {dur(ss['age']):>6} {DIM}cpu{R} {ss['cpu']:5.1f}"
                     f" {DIM}{human(ss['rss']):>7}  out{R} {kilo(s['own']):>6}"
                     f" {DIM}+agents{R} {kilo(s['aout']):>6} {DIM}agents{R} {ag}")
    if not st["sessions"]:
        right.append(f" {DIM}no live sessions{R}")
    for i in range(max(len(left), len(right))):
        L.append(pad(left[i] if i < len(left) else "", lw + 2)
                 + (right[i] if i < len(right) else ""))
    return "\n".join(L[:H])

def term_size():
    try:
        s = os.get_terminal_size(); return s.columns, s.lines
    except OSError:
        return int(os.environ.get("COLUMNS", 200)), int(os.environ.get("LINES", 50))

def main():
    a = sys.argv[1:]; once = "--once" in a; iv = 0.1
    if "-i" in a:
        try: iv = max(.05, float(a[a.index("-i") + 1]))
        except (ValueError, IndexError): pass
    st = {"cpu": 0., "u": 0., "s": 0., "cpu_h": [], "mem_h": [], "gpu_h": [], "ch": [],
          "rx": 0, "tx": 0, "interval": iv, "cost": 0., "load": "", "sessions": [],
          "arecs": {}, "astatus": ("indexing", 0, 0), "aruns": [], "attl": [],
          "astat": {}, "nagent": 0, "procs": [], "pmap": {},
          "limits": (-1, 0, -1, 0, -1, 0),
          "mem": (0, 1, 0, 0, 0, 0), "swap": 0, "batt": (None, ""), "disk": (0, 0),
          "cores": [], "tok": {}, "last": {}}
    if once:
        for _ in range(9): collect(st); time.sleep(.05)
        w, h = term_size(); print(frame(st, w, h)); return
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd) if sys.stdin.isatty() else None
    try:
        if old: tty.setcbreak(fd)
        sys.stdout.write("\033[?1049h\033[?25l"); collect(st)
        while True:
            w, h = term_size()
            sys.stdout.write("\033[H\033[2J" + frame(collect(st), w, h)); sys.stdout.flush()
            if old:
                import select
                r, _, _ = select.select([fd], [], [], iv)
                if r and sys.stdin.read(1) in ("q", "Q", "\x03"): break
            else: time.sleep(iv)
    except KeyboardInterrupt: pass
    finally:
        sys.stdout.write("\033[?25h\033[?1049l"); sys.stdout.flush()
        if old: termios.tcsetattr(fd, termios.TCSADRAIN, old)

if __name__ == "__main__":
    main()
