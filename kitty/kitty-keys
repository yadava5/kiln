#!/usr/bin/python3
"""Cheatsheet renderer, bound to cmd+/ as a kitty overlay.

Reads the `#|` comment rows straight out of kitty.conf (grammar documented
at the top of its Keys section) — there is no second cheatsheet file to
drift. `#|= NAME` starts a section; `#|` rows are either `key  <2+ sp>
action` pairs or free prose.

Layout: sections pack into two balanced columns when the overlay is wide
enough, one otherwise. Colours are ANSI palette indices (amber 3, dim 8),
never hex, so a theme switch recolours the sheet with everything else.
The masthead cat is the statusline's resident — the same three rows of
ordinary characters, so there is one creature across the whole setup. Output pipes through less so / searches and q closes.

Absolute tool paths on purpose: interactive aliases shadow cat/less here.
"""
import os
import re
import subprocess
import sys

CONF = '/Users/ayush/.config/kitty/kitty.conf'

# ── palette: SGR only, resolved by the live theme ────────────────────────
R = '\033[0m'
KEY = '\033[1;33m'       # bold amber: the keys themselves
HEAD = '\033[1;33m'      # section names
RULE = '\033[38;5;8m'    # dim parchment rules
DESC = '\033[39m'        # default fg
DIM = '\033[38;5;8m'     # annotations, prose
ACC = '\033[38;5;1m'     # terracotta accents (the ball, the title dot)

DEFAULT_RE = re.compile(r'\(kitty default\)\s*$')

# The cat is the same three-row cat that lives in the Claude Code
# statusline — one creature, two homes. It replaced a sextant pixel
# sprite copied from the old tab_bar.py: at three subcells tall that read
# as a grey lump, not an animal, and it was removed everywhere 2026-08-08.
# Four rows, matching the statusline cat exactly — one creature across the
# whole setup. It grew a paw row on 2026-08-09 when it moved off the
# one-row tab bar and onto the statusline stage.
CAT_ROWS = (' /\\___/\\ ', '(  o.o  )', ' >  ^  < ', '  U    U ')


def parse(path):
    """[(name, [(key, desc) | ('', prose)])], from the #| grammar."""
    sections = []
    for line in open(path, encoding='utf-8'):
        if line.startswith('#|='):
            sections.append((line[3:].strip(), []))
        elif line.startswith('#|') and sections:
            row = line[2:].rstrip()
            if row.startswith('  '):
                row = row[2:]
            if not row:
                sections[-1][1].append(('', ''))
                continue
            m = re.search(r'\S(  +)', row)
            if m and row[:m.start(1)].strip():
                key = row[:m.start(1)].strip()
                desc = row[m.end(1):].strip()
                sections[-1][1].append((key, desc))
            else:
                sections[-1][1].append(('', row.strip()))
    return sections


def wrap(text, width):
    words, lines, cur = text.split(), [], ''
    for w in words:
        if cur and len(cur) + 1 + len(w) > width:
            lines.append(cur)
            cur = w
        else:
            cur = f'{cur} {w}'.strip()
    if cur:
        lines.append(cur)
    return lines or ['']


def render_section(name, rows, width):
    """One section as a list of exactly-`width` display lines."""
    out = []
    rule = '─' * max(0, width - len(name) - 4)
    out.append(f'{HEAD}{name}{R} {RULE}──{R} {RULE}{rule}{R}',)
    out.append('')
    keyw = max([len(k) for k, d in rows if k] or [0])
    keyw = min(keyw, 20)
    for key, desc in rows:
        if not key and not desc:
            out.append('')
            continue
        if not key:                                   # prose row
            for ln in wrap(desc, width - 2):
                out.append(f'  {DIM}{ln}{R}')
            continue
        note = ''
        if DEFAULT_RE.search(desc):
            desc = DEFAULT_RE.sub('', desc).rstrip()
            note = f'  {DIM}· default{R}'
        body = width - keyw - 4
        first, *rest = wrap(desc, body)
        out.append(f'  {KEY}{key:<{keyw}}{R}  {DESC}{first}{R}{note}')
        for ln in rest:
            out.append(f'  {"":<{keyw}}  {DESC}{ln}{R}')
    out.append('')
    return out


def visible_len(s):
    return len(re.sub(r'\033\[[0-9;]*m', '', s))


def main():
    try:
        cols = os.get_terminal_size(sys.stderr.fileno()).columns
    except OSError:
        cols = int(os.environ.get('COLUMNS', 120))
    cols = min(cols, 190)
    sections = parse(CONF)

    two_col = cols >= 110
    gutter = 6
    colw = (cols - gutter - 4) // 2 if two_col else cols - 4

    blocks = [render_section(n, rows, colw) for n, rows in sections]

    out = []
    pad = '  '
    # ── masthead ─────────────────────────────────────────────────────────
    title = f'{HEAD}kitty{R} {ACC}·{R} {DESC}keys{R}'
    hint = f'{DIM}q closes · / searches{R}'
    out.append('')
    out.append(f'{pad}{DIM}{CAT_ROWS[0]}{R}')
    left = f'{pad}{DIM}{CAT_ROWS[1]}{R}  {title}'
    space = cols - visible_len(left) - visible_len(hint) - 2
    out.append(left + ' ' * max(2, space) + hint)
    out.append(f'{pad}{DIM}{CAT_ROWS[2]}{R}')
    out.append(f'{pad}{DIM}{CAT_ROWS[3]}{R}')
    out.append(f'{pad}{RULE}{"─" * (cols - 4)}{R}')
    out.append('')

    if two_col:
        # balance sections into two columns by height, keeping order
        total = sum(len(b) for b in blocks)
        lcol, rcol, h = [], [], 0
        for b in blocks:
            if h + len(b) <= (total + 1) // 2 or not lcol:
                lcol += b
                h += len(b)
            else:
                rcol += b
        for i in range(max(len(lcol), len(rcol))):
            lline = lcol[i] if i < len(lcol) else ''
            rline = rcol[i] if i < len(rcol) else ''
            fill = ' ' * (colw - visible_len(lline))
            out.append(f'{pad}{lline}{fill}{" " * gutter}{rline}')
    else:
        for b in blocks:
            out.extend(pad + ln for ln in b)

    out.append(f'{pad}{RULE}{"─" * (cols - 4)}{R}')
    out.append(f'{pad}{DIM}every other action: {R}{KEY}cmd+shift+p{R}'
               f'{DIM} — the command palette, fuzzy searchable{R}')
    out.append('')

    text = '\n'.join(out) + '\n'
    # +g pins the view to the top: without it less lands on (END) with the
    # sheet hanging from the bottom of the overlay (seen by screenshot).
    pager = subprocess.Popen(
        ['/usr/bin/less', '-R', '--tilde', '+g'], stdin=subprocess.PIPE)
    pager.communicate(text.encode())


if __name__ == '__main__':
    main()
